    {
      "para_index": 4,
      "text": "\u7814\u7a76\u5bf9\u8c61\uff1aPMSG \u5168\u529f\u7387\u6784\u7f51\u578b\u98ce\u7535\u673a\u7ec4\uff0c\u4e24\u8d28\u91cf\u5757\u4f20\u52a8\u94fe\uff0c\u7ea6 2 Hz \u626d\u632f\u6a21\u6001",
      "style": "Normal"
    },
    {
      "para_index": 5,
      "text": "\u6a21\u578b\u7248\u672c\uff1a\u542b\u6c14\u52a8\u8f6c\u77e9\u7ebf\u6027\u5316\u3001\u4f20\u52a8\u94fe\u81ea\u963b\u5c3c\u3001MPPT \u659c\u7387\u53cd\u9988\u4e0e APCAD \u652f\u8def\u7684\u6700\u65b0\u7a0b\u5e8f",
      "style": "Normal"
    },
    {
      "para_index": 6,
      "text": "\u7ed3\u679c\u6765\u6e90\uff1a2026-05-24 \u91cd\u65b0\u5bfc\u51fa\u7684\u7edf\u4e00\u72b6\u6001\u7a7a\u95f4\u6a21\u578b\u53ca\u91cd\u65b0\u8fd0\u884c\u7684 MATLAB \u626b\u63cf\u7ed3\u679c",
      "style": "Normal"
    },
    {
      "para_index": 7,
      "text": "\u6587\u732e\u4f9d\u636e\uff1aZotero \u6587\u5e93\uff1a\u673a\u7535\u8026\u5408\u632f\u8361\u3001\u6784\u7f51\u578b\u63a7\u5236\u53ca Type-IV GFM-WT \u5173\u952e\u8bba\u6587",
      "style": "Normal"
    },
    {
      "para_index": 8,
      "text": "\u7ed3\u8bba\u7528\u9014\uff1a\u4f5c\u4e3a\u8bba\u6587\u673a\u7406\u5206\u6790\u3001\u63a7\u5236\u8bbe\u8ba1\u4e0e\u540e\u7eed Simulink/RT-LAB \u9a8c\u8bc1\u7684\u5de5\u4f5c\u5e95\u7a3f",
      "style": "Normal"
    },
    {
      "para_index": 21,
      "text": "\u0394Taero = -Daero \u0394\u03c9t + Kv,aero \u0394vw + K\u03b2,aero \u0394\u03b2",
      "style": "Normal"
    },
    {
      "para_index": 97,
      "text": "\u7ed3\u8bba\u6458\u8981",
      "style": "Normal"
    },
    {
      "para_index": 99,
      "text": "\u6587\u732e\u4e0e\u6a21\u578b\u5bf9\u5e94\u70b9",
      "style": "Normal"
